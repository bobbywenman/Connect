# Copy to .env (gitignored) and fill in. Only EXPO_PUBLIC_* values are readable by the app.

# Hosted project (default). Publishable key: Dashboard > Project Settings > API Keys (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_URL=https://mpbmcgyknbpriwhanait.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local Supabase instead: run `npm run db:start`, then use the "Project URL" and
# "Publishable" key printed by `npx supabase status`, e.g.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (On a physical device use your computer's LAN IP instead of 127.0.0.1.)
# Never put the secret / service role key here.
