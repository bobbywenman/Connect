{
  "expo": {
    "name": "KnowThem",
    "slug": "knowthem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bobbywenman.knowthem"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bobbywenman.knowthem"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "KnowThem uses your photos so you can add a picture of someone you know.",
          "cameraPermission": "KnowThem uses your camera so you can take a picture of someone you know.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "knowthem",
    "experiments": {
      "typedRoutes": true
    }
  }
}
